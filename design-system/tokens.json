{
  "name": "RoboPet",
  "version": 1,
  "meta": {
    "source": "github",
    "repo": "psychemulation-enterprises/robopet",
    "paths": {
      "tokens": ["src/index.css", "index.html", "public/manifest.json"],
      "usage": ["src/components/**/*.tsx"]
    },
    "note": "Classic values are the Tailwind slate/cyan/violet/emerald utilities the app uses today. Cyberpunk is the Stark Neon redraft: saturated cyan, fuchsia, ultraviolet, hot pink, electric blue, acid green, yellow and signal red on a near-black ultraviolet void."
  },
  "color": {
    "themes": [
      { "id": "classic", "name": "Classic" },
      { "id": "cyberpunk", "name": "Cyberpunk Retro" }
    ],
    "tokens": [
      { "name": "surface-base", "value": { "classic": "#020617", "cyberpunk": "#050008" }, "usage": "Page background (body, slate-950). Sits behind every panel." },
      { "name": "surface-panel", "value": { "classic": "#0f172a", "cyberpunk": "#0e0619" }, "usage": "Header, cards and modals (slate-900)." },
      { "name": "surface-raised", "value": { "classic": "#1e293b", "cyberpunk": "#26124a" }, "usage": "Inputs, hover fills and inset wells inside a panel (slate-800)." },
      { "name": "border-default", "value": { "classic": "#1e293b", "cyberpunk": "#26124a" }, "usage": "1px panel and divider borders (border-slate-800)." },
      { "name": "border-strong", "value": { "classic": "#334155", "cyberpunk": "#3d1f73" }, "usage": "Input and control outlines (border-slate-700)." },
      { "name": "text-primary", "value": { "classic": "#f1f5f9", "cyberpunk": "#f4ecff" }, "usage": "Headings and key values. 4.5:1+ on every surface." },
      { "name": "text-secondary", "value": { "classic": "#cbd5e1", "cyberpunk": "#d6c6f2" }, "usage": "Body copy and table cells." },
      { "name": "text-muted", "value": { "classic": "#94a3b8", "cyberpunk": "#a99ccc" }, "usage": "Captions, labels and helper text." },
      { "name": "text-faint", "value": { "classic": "#64748b", "cyberpunk": "#8a7db3" }, "usage": "Placeholders and timestamps. Never for required information." },
      { "name": "accent", "value": { "classic": "#22d3ee", "cyberpunk": "#00ffff" }, "usage": "Primary interactive colour: links, active tabs, icons, focus (cyan-400). The app's most used hue." },
      { "name": "accent-solid", "value": { "classic": "#06b6d4", "cyberpunk": "#01e0e1" }, "usage": "Filled primary buttons (cyan-500). Text on it is on-accent." },
      { "name": "accent-dim", "value": { "classic": "#083344", "cyberpunk": "#04242b" }, "usage": "Tinted fill behind accent text (cyan-950)." },
      { "name": "accent-border", "value": { "classic": "#155e75", "cyberpunk": "#028c90" }, "usage": "Border on accent-dim fills (cyan-800)." },
      { "name": "secondary", "value": { "classic": "#a78bfa", "cyberpunk": "#ff00e5" }, "usage": "Secondary hue for AI, LLM and creative surfaces (violet-400; fuchsia in Cyberpunk)." },
      { "name": "secondary-dim", "value": { "classic": "#2e1065", "cyberpunk": "#280027" }, "usage": "Tinted fill behind secondary text (violet-950)." },
      { "name": "brand", "value": { "classic": "#a855f7", "cyberpunk": "#a43dff" }, "usage": "The ROBOPET wordmark and PWA theme colour." },
      { "name": "brand-deep", "value": { "classic": "#1e1b4b", "cyberpunk": "#1b092b" }, "usage": "Icon tile background and PWA splash." },
      { "name": "success", "value": { "classic": "#34d399", "cyberpunk": "#39ff14" }, "usage": "Compatible, in-budget, passing (emerald-400)." },
      { "name": "success-dim", "value": { "classic": "#022c22", "cyberpunk": "#0c240a" }, "usage": "Fill behind success text." },
      { "name": "warning", "value": { "classic": "#fbbf24", "cyberpunk": "#ffff00" }, "usage": "Caution, near-budget, pending (amber-400)." },
      { "name": "warning-dim", "value": { "classic": "#451a03", "cyberpunk": "#282407" }, "usage": "Fill behind warning text." },
      { "name": "danger", "value": { "classic": "#fb7185", "cyberpunk": "#ff3b30" }, "usage": "Errors, incompatibility, destructive actions, Support button (rose-400)." },
      { "name": "danger-dim", "value": { "classic": "#4c0519", "cyberpunk": "#28080e" }, "usage": "Fill behind danger text." },
      { "name": "on-accent", "value": { "classic": "#020617", "cyberpunk": "#050008" }, "usage": "Text on accent-solid and other bright fills." }
    ]
  },
  "type": {
    "fonts": [],
    "families": {
      "sans": "\"Inter\", \"Roboto\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace",
      "display": "\"Space Grotesk\", sans-serif",
      "cyber-sans": "\"Chakra Petch\", \"Inter\", ui-sans-serif, system-ui, sans-serif",
      "cyber-mono": "\"Share Tech Mono\", \"JetBrains Mono\", ui-monospace, monospace",
      "cyber-display": "\"Orbitron\", \"Space Grotesk\", sans-serif"
    },
    "groups": [
      {
        "name": "Classic",
        "family": "sans",
        "styles": [
          { "name": "classic-title", "family": "display", "fontSize": "18px", "lineHeight": "28px", "fontWeight": 700, "letterSpacing": "-0.025em", "usage": "Header wordmark; uppercase." },
          { "name": "classic-body", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400, "usage": "Default body." },
          { "name": "classic-label", "family": "mono", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 700, "usage": "Buttons, chips, table headers." }
        ]
      },
      {
        "name": "Cyberpunk Retro",
        "family": "cyber-sans",
        "styles": [
          { "name": "cyber-title", "family": "cyber-display", "fontSize": "18px", "lineHeight": "28px", "fontWeight": 800, "letterSpacing": "0.08em", "usage": "Header wordmark and section titles; uppercase, glowing." },
          { "name": "cyber-body", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400, "usage": "Default body." },
          { "name": "cyber-label", "family": "cyber-mono", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400, "letterSpacing": "0.1em", "usage": "Buttons, chips, table headers; uppercase, tracked." }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      { "name": "space-1", "value": "4px", "usage": "Icon-to-label gap." },
      { "name": "space-2", "value": "8px", "usage": "Button group gap, chip padding." },
      { "name": "space-3", "value": "12px", "usage": "Compact card padding." },
      { "name": "space-4", "value": "16px", "usage": "Card padding, page gutter on mobile." },
      { "name": "space-6", "value": "24px", "usage": "Section spacing, page gutter on desktop." },
      { "name": "space-8", "value": "32px", "usage": "Between major sections." }
    ]
  },
  "radius": {
    "tokens": [
      { "name": "radius-md", "value": "6px", "usage": "Classic: small chips (rounded-md)." },
      { "name": "radius-lg", "value": "8px", "usage": "Classic: buttons and inputs (rounded-lg). Most used." },
      { "name": "radius-xl", "value": "12px", "usage": "Classic: cards (rounded-xl)." },
      { "name": "radius-2xl", "value": "16px", "usage": "Classic: modals (rounded-2xl)." },
      { "name": "radius-full", "value": "9999px", "usage": "Classic: badges and avatars." },
      { "name": "radius-cyber", "value": "2px", "usage": "Cyberpunk: every control and card. Corners are nearly square; use a clipped corner for emphasis." }
    ]
  },
  "shadow": {
    "tokens": [
      { "name": "shadow-panel", "value": { "classic": "0 10px 15px rgba(0,0,0,0.3)", "cyberpunk": "0 0 0 1px rgba(164,61,255,0.3), 0 0 18px rgba(255,0,229,0.16)" }, "usage": "Header and cards. Cyberpunk swaps depth for neon edge glow." },
      { "name": "shadow-glow", "value": { "classic": "0 4px 12px rgba(168,85,247,0.2)", "cyberpunk": "0 0 14px rgba(255,0,229,0.65)" }, "usage": "Brand tile and hovered primary controls." }
    ]
  }
}
